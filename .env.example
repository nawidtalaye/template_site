# Public origin of the deployed site. Used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://novatechsoft.com

# Where contact-form leads are delivered (any endpoint that accepts a JSON POST).
# If unset, leads are written to the server log instead of being dropped.
LEAD_WEBHOOK_URL=

# WhatsApp delivery for contact-form leads, via the official Cloud API.
# WHATSAPP_TO           destination number, digits with country code (93...)
# WHATSAPP_PHONE_NUMBER_ID  from Meta > WhatsApp > API Setup
# WHATSAPP_ACCESS_TOKEN     permanent System User token (temporary ones die in 24h)
# WHATSAPP_TEMPLATE_NAME    approved template; leave empty to send plain text,
#                           which only works inside the 24h window that opens
#                           when the destination number messages the business.
WHATSAPP_TO=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Number the wa.me hand-off addresses, digits with country code. Public by
# design: it ends up in the client bundle, exactly like the site phone number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
